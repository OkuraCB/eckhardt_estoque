generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Token {
  id Int @id @default(autoincrement())

  createdAt DateTime? @default(now()) @map("create_time") @db.Timestamp(0)
  updatedAt DateTime? @map("update_time") @db.Timestamp(0)

  token String @db.VarChar(3000)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_users_tokens")

  @@index([userId], map: "fk_tokens_users1_idx")
  @@map("tokens")
}

model User {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now()) @map("create_time") @db.Timestamp(0)
  updatedAt DateTime? @map("update_time") @db.Timestamp(0)

  name     String @db.VarChar(100)
  email    String @unique(map: "email_UNIQUE") @db.VarChar(300)
  password String @db.VarChar(300)

  role Role @default(USER)

  tokens Token[]

  @@map("users")
}

model Product {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now()) @map("create_time") @db.Timestamp(0)
  updatedAt DateTime? @map("update_time") @db.Timestamp(0)

  name      String  @db.VarChar(100)
  code      String?  @unique(map: "code_UNIQUE") @db.VarChar(50) 
  price     Float
  qty     Int
  description String?  @db.Text()

  collection  Collection?  @relation(fields: [collectionId], references: [id])
  model       Model? @relation(fields: [modelId],  references: [id])
  
  length  Float?
  width   Float?
  height  Float?

  addonName String? @db.VarChar(100)
  heightAddon Float?

  image1  String?
  image2  String?
  image3  String?

  collectionId  Int
  modelId Int
}

model Collection {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now()) @map("create_time") @db.Timestamp(0)
  updatedAt DateTime? @map("update_time") @db.Timestamp(0)
  
  name  String  @unique @db.VarChar(100)

  products  Product[]
}

model Model {
  id Int @id @default(autoincrement())

  createdAt DateTime  @default(now()) @map("create_time") @db.Timestamp(0)
  updatedAt DateTime? @map("update_time") @db.Timestamp(0)
  
  name  String  @unique @db.VarChar(100)

  products  Product[]
}

enum Role {
  USER
  ADMIN
}
